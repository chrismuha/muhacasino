# Dependencies
node_modules/
# Dropbox may create numbered conflict copies such as "node_modules 2".
node_modules */

# Compiled and packaged output
dist/
dist-electron/
out/
release/
.vite/

# Logs and local settings
logs/
*.log
.env
.env.*
!.env.example
*.local

# Generated packaging metadata
build/*.source.sha256
build/icon.iconset/

# Operating system and editor files
.DS_Store
**/.DS_Store
**/._*
.idea/

# Dropbox conflict copies are reconciled manually and should never be committed.
*conflicted copy*
