{
  "appId": "com.mcr.bingo",
  "productName": "Bingo",
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "build/**/*",
    "main.js",
    "package.json"
  ],
  "forceCodeSigning": false,
  "mac": {
    "category": "public.app-category.utilities",
    "identity": null,
    "icon": "build/icon.icns"
  },
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico"
  },
  "linux": {
    "target": "AppImage",
    "icon": "build/icon.png"
  }
}
